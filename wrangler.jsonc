{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "back-end-fimap",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "73918426",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
