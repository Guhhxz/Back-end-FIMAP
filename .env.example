# Chave secreta da Geoapify para busca de estabelecimentos no chat.
# Configure também esta variável como secret no ambiente onde o backend estiver hospedado.
GEOAPIFY_API_KEY=

# Endereço da IA publicada na Cloudflare.
CLOUDFLARE_WORKER_URL=https://back-end-fimap-novop.fimap-agency.workers.dev/chat

# Credenciais financeiras: configure como secrets no Worker da IA.
# O .env do Express não transfere estas chaves ao Worker automaticamente.
HG_BRASIL_API_KEY=
BRAPI_TOKEN=

# Configurações opcionais do Worker (vars, sem segredos).
FINANCIAL_TOOLS_ENABLED=true
FINANCIAL_MAX_TOOL_CALLS=4
FINANCIAL_MAX_TOOL_ROUNDS=3
FINANCIAL_MAX_HTTP_CALLS=8
FINANCIAL_MAX_CONCURRENT=4
FINANCIAL_MAX_DAILY_HTTP=100
FINANCIAL_HTTP_TIMEOUT_MS=6000
FINANCIAL_HTTP_RETRIES=1
FINANCIAL_PLANNER_TIMEOUT_MS=15000
FINANCIAL_TTL_QUOTE=60
FINANCIAL_TTL_RATES=3600
FINANCIAL_TTL_HISTORY=21600
FINANCIAL_TTL_BANKS=86400
FINANCIAL_TTL_FIPE=86400
FINANCIAL_PROVIDERS_ACOES=brapi,hgbrasil
FINANCIAL_PROVIDERS_CRIPTO=brapi,hgbrasil
FINANCIAL_PROVIDERS_PTAX=bcb,brasilapi
