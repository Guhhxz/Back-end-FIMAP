# PARA QUE SERVE: mostrar os campos de configuração da IA e da porta do backend.
# QUANDO ENTRA EM AÇÃO: quando você copia os campos necessários para o seu .env local.
# QUANDO FAZ DIFERENÇA: permite escolher o endereço da IA sem editar o serviço.
# Este arquivo é um exemplo; o backend carrega o .env, não o .env.example.

# Rota privada para o chat autenticado. O prompt e o modelo ficam no Worker.
CLOUDFLARE_WORKER_URL=https://ia-fimap.fimap-agency.workers.dev/v1/ia/chat
# Mesmo valor de CHAT_API_TOKEN no Worker; preencher somente no ambiente privado.
CLOUDFLARE_CHAT_TOKEN=
JWT_SECRET=
JWT_EXPIRATION=1h
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=db_fimap_2026
PORT=8080
