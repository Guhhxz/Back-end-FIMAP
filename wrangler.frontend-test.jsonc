// PARA QUE SERVE ESTE ARQUIVO
//
// Este arquivo reúne as escolhas usadas para abrir ou publicar a IA junto
// com a página de teste na Cloudflare. Ele informa o nome do projeto,
// o programa que deve receber os pedidos e onde estão os arquivos da página.
//
// O programa escolhido é src/testUiWorker.ts. Os arquivos que aparecem
// no navegador ficam em frontend-test. A parte de IA continua sendo
// atendida pelo programa principal do projeto.
//
// QUANDO É USADO
// É lido pelo comando npm run ui:deploy.
// O comando npm run deploy usa wrangler.jsonc, que é a escolha normal
// para publicar somente a IA, sem a página de teste.
//
// ATENÇÃO AO PUBLICAR
// Este arquivo aponta para o mesmo projeto back-end-fimap. Publicar com
// ui:deploy atualiza esse projeto com a página de teste incluída; não cria
// sozinho um site separado. O nome do perfil e a conta usada no login
// determinam em qual conta a publicação será feita.
//
// SE ESTE ARQUIVO FOR APAGADO
// O comando ui:deploy precisa ser retirado ou ajustado.
// A publicação normal da IA não depende deste arquivo.

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Nome do projeto que será atualizado na conta escolhida.
  "name": "back-end-fimap",
  "workers_dev": true,
  "preview_urls": false,
  // Programa que separa os pedidos da página e os pedidos para a IA.
  "main": "src/testUiWorker.ts",
  // Data que mantém as regras de execução esperadas por este projeto.
  "compatibility_date": "2026-10-21",
  // Permite que o programa use o serviço de IA da Cloudflare.
  "ai": {
    "binding": "AI"
  },
  // Indica onde ficam os arquivos que serão mostrados no navegador.
  "assets": {
    "directory": "./frontend-test",
    "binding": "ASSETS",
    // Estes pedidos passam primeiro pelo programa que atende a IA.
    "run_worker_first": [
      "/v1/ia/*",
      "/chat",
      "/health"
    ]
  },
  // Limita a quantidade de pedidos para evitar uso excessivo.
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      // Identificação usada para contar os pedidos desse limite.
      "namespace_id": "73918426",
      // Permite até 12 pedidos por minuto para cada endereço de acesso.
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
